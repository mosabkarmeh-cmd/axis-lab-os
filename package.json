{
  "name": "axis-lab-os",
  "private": true,
  "version": "0.12.7",
  "description": "AXIS LAB OS - نظام تشغيل ورش القص والنقش بالليزر",
  "author": "AXIS LAB",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:smoke": "npm run build && npx tsx tests/currency-conversion-smoke.ts && node tests/api-security-smoke.cjs && node tests/first-run-password-smoke.cjs && node tests/api-coverage-smoke.cjs && node tests/sqlite-migration-smoke.cjs && node tests/sqlite-crash-recovery-smoke.cjs && node tests/sqlite-concurrency-stability-smoke.cjs",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/db/drizzle.config.ts",
    "start:prod": "NODE_ENV=production node dist/server.cjs",
    "desktop:build": "npm run build",
    "desktop:preview": "npm run desktop:build && electron desktop/main.cjs",
    "desktop:package:win": "npm run desktop:build && electron-builder --win nsis --config electron-builder.yml",
    "desktop:package:win:current": "npm run desktop:build && electron-builder --win nsis --config electron-builder.yml",
    "desktop:package:win:all": "npm run desktop:build && electron-builder --win nsis --config electron-builder.all-users.yml",
    "test:coverage": "npm run build && node tests/api-coverage-smoke.cjs",
    "test:sqlite-migration": "npm run build && node tests/sqlite-migration-smoke.cjs",
    "test:sqlite-crash": "npm run build && node tests/sqlite-crash-recovery-smoke.cjs",
    "test:sqlite-concurrency": "npm run build && node tests/sqlite-concurrency-stability-smoke.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.21.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
